@using EclipsVault.Web.Extensions
@model IReadOnlyList<SecretListItemViewModel>
@{
    ViewData["Title"] = "Secrets";
    var now = DateTimeOffset.UtcNow;
}

<div class="page-header">
    <div>
        <h1>Secrets</h1>
        <p class="page-sub">@Model.Count active secret@(Model.Count == 1 ? "" : "s"). Opening one records an audit entry.</p>
    </div>
    <div class="page-actions">
        <a class="button primary" asp-action="Create">New secret</a>
    </div>
</div>

<section class="panel">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyState {
            Icon = "lock",
            Title = "The vault is empty",
            Message = "Store your first secret — it's sealed with AES-256-GCM envelope encryption before it ever touches the database.",
            ActionText = "Store a secret", ActionController = "Secrets", ActionAction = "Create" })" />
    }
    else
    {
        <div class="table-toolbar">
            <input type="search" class="table-search" placeholder="Filter by name, project, environment…" data-filter="#secrets-table" aria-label="Filter secrets" />
        </div>
        <table class="data-table" id="secrets-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Project</th>
                    <th>Environment</th>
                    <th>Sensitivity</th>
                    <th>Expires (UTC)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var expiresSoon = item.ExpiresAtUtc is { } exp && exp <= now.AddDays(7);
                    <tr data-href="@Url.Action("Details", new { id = item.Id })">
                        <td class="mono cell-strong">@item.Name</td>
                        <td>@item.ProjectKey</td>
                        <td><span class="badge env-@item.Environment.ToString().ToLowerInvariant()">@item.Environment</span></td>
                        <td><span class="badge sens-@((int)item.Sensitivity)">@item.Sensitivity.ToDisplayName()</span></td>
                        <td class="muted">
                            @(item.ExpiresAtUtc?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "—")
                            @if (expiresSoon)
                            {
                                <span class="badge tone-warn">soon</span>
                            }
                        </td>
                        <td class="cell-actions">
                            <a class="button small" asp-action="Details" asp-route-id="@item.Id">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
