@using EclipsVault.Web.Extensions
@model CreateSecretViewModel
@{
    ViewData["Title"] = "New secret";
}

<div class="page-header">
    <div>
        <h1>New secret</h1>
        <p class="page-sub">The value is envelope-encrypted (AES-256-GCM) before it touches the database.</p>
    </div>
</div>

<section class="panel narrow-left">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field">
            <label asp-for="Name"></label>
            <input asp-for="Name" placeholder="Phoenix_Prod_Db_Password" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Value"></label>
            <textarea asp-for="Value" rows="4" spellcheck="false"></textarea>
            <span asp-validation-for="Value" class="field-error"></span>
        </div>

        <div class="field-row">
            <div class="field">
                <label asp-for="ProjectKey"></label>
                <input asp-for="ProjectKey" />
                <span asp-validation-for="ProjectKey" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="TtlDays"></label>
                <input asp-for="TtlDays" type="number" min="0" max="3650" />
                <span asp-validation-for="TtlDays" class="field-error"></span>
            </div>
        </div>

        <div class="field-row">
            <div class="field">
                <label asp-for="Environment"></label>
                <select asp-for="Environment" asp-items="Html.GetEnumSelectList<SecretEnvironment>()"></select>
            </div>
            <div class="field">
                <label asp-for="Sensitivity"></label>
                <select asp-for="Sensitivity" asp-items="EnumDisplay.SensitivitySelectList()"></select>
                <span asp-validation-for="Sensitivity" class="field-error"></span>
            </div>
        </div>

        <p class="hint muted">
            Sensitivity may not exceed your own clearance. Secrets with a TTL are
            shredded automatically once it elapses.
        </p>

        <button type="submit" class="button primary">Encrypt and store</button>
    </form>
</section>
