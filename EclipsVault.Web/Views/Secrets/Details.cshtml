@model SecretDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    var now = DateTimeOffset.UtcNow;
}

<div class="page-header">
    <div>
        <h1 class="mono">@Model.Name</h1>
        <p class="page-sub">
            <span class="badge env-@Model.Environment.ToString().ToLowerInvariant()">@Model.Environment</span>
            <span class="badge sens-@((int)Model.Sensitivity)">@Model.Sensitivity</span>
            <span class="badge">@Model.ProjectKey</span>
        </p>
    </div>
    <div class="page-actions">
        <a class="button" asp-action="Index">Back to list</a>
    </div>
</div>

<div class="two-col">
    <section class="panel">
        <div class="panel-header"><h2>Secret value</h2></div>
        @if (Model.RevealedValue is not null)
        {
            <div class="revealed-box">
                <div class="revealed-head">
                    <strong>Decrypted @(Model.RevealedLabel ?? "value")</strong>
                    <button type="button" class="button small" data-copy="#revealed-value">Copy</button>
                </div>
                <code class="secret-code" id="revealed-value">@Model.RevealedValue</code>
                <p class="muted">This reveal was recorded in the audit trail before decryption. The value is shown once — reload to hide it.</p>
            </div>
        }
        else if (Model.StepUpRequired)
        {
            <div class="notice notice-warn">
                <strong>Re-authentication required.</strong>
                <span>Because this value is classified <strong>@Model.Sensitivity</strong> and your last sign-in is more than @Model.StepUpMaxAgeMinutes minute@(Model.StepUpMaxAgeMinutes == 1 ? "" : "s") old, confirm a fresh authenticator code to reveal it.</span>
            </div>
            <form class="inline-form" asp-action="StepUpReveal" asp-route-id="@Model.Id" method="post">
                @if (Model.StepUpVersionId is { } vid)
                {
                    <input type="hidden" name="versionId" value="@vid" />
                }
                <div class="field">
                    <label for="stepup-code">Authenticator code</label>
                    <input id="stepup-code" name="code" class="code-input" inputmode="numeric"
                           autocomplete="one-time-code" maxlength="6" autofocus />
                    @if (Model.StepUpError is not null)
                    {
                        <span class="field-error">@Model.StepUpError</span>
                    }
                </div>
                <button type="submit" class="button primary">Verify and reveal</button>
            </form>
        }
        else
        {
            <p class="muted">
                The value is stored as AES-256-GCM ciphertext with its own single-use
                data encryption key. Revealing decrypts it for this response only and
                is audited first (fail-closed).
            </p>
            <form class="inline-form" asp-action="Reveal" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="button primary">Reveal value</button>
            </form>
        }

        <hr class="divider" />

        @if (Model.IsManaged)
        {
            <div class="notice">
                <strong>Managed credential.</strong>
                <span>
                    This is the live password of <code class="mono">@Model.RotationPrincipal</code>. The vault can
                    rotate it for real: it generates a new password, changes the principal upstream, and stores the
                    result — so the stored value and the live credential can't drift apart, and nobody handles the
                    password. If storing fails, the upstream change is put back.
                </span>
            </div>
            <form class="inline-form" asp-action="RotateManaged" asp-route-id="@Model.Id" method="post">
                <input name="renewTtlDays" type="number" min="1" max="3650" class="input-narrow"
                       placeholder="renew (days)" aria-label="Renew for days" title="Optional: also push the expiry out by this many days" />
                <button type="submit" class="button primary"
                        data-confirm="Rotate the real password of '@Model.RotationPrincipal'? Anything still using the old password stops working immediately.">
                    Rotate upstream
                </button>
            </form>

            <hr class="divider" />
        }

        <details class="rotate">
            <summary class="button">@(Model.IsManaged ? "Rotate value manually" : "Rotate value")</summary>
            <form asp-action="Rotate" method="post" class="rotate-form">
                <input type="hidden" name="Id" value="@Model.Id" />
                <div class="field">
                    <label for="NewValue">New value</label>
                    <textarea id="NewValue" name="NewValue" rows="3" spellcheck="false" required></textarea>
                </div>
                <div class="field">
                    <label for="ChangeNote">Change note (optional)</label>
                    <input id="ChangeNote" name="ChangeNote" maxlength="256" placeholder="e.g. quarterly rotation" />
                </div>
                <div class="field">
                    <label for="RenewTtlDays">Renew for (days)</label>
                    <input id="RenewTtlDays" name="RenewTtlDays" type="number" min="1" max="3650"
                           placeholder="@(Model.ExpiresAtUtc is null ? "no expiry set — leave blank to keep it that way" : "leave blank to keep the current expiry")" />
                    <p class="hint">
                        @if (Model.ExpiresAtUtc is { } expiry)
                        {
                            <text>Expires @expiry.ToString("u"). Rotating alone does not move that deadline — set a renewal to push it out, or the lifecycle worker will shred this value on schedule.</text>
                        }
                        else
                        {
                            <text>This secret has no expiry. Setting a renewal gives it one.</text>
                        }
                    </p>
                </div>
                <button type="submit" class="button primary"
                        data-confirm="Rotate '@Model.Name'? The current value is archived to history and replaced.">Rotate secret</button>
            </form>
        </details>
    </section>

    <section class="panel">
        <div class="panel-header"><h2>Metadata</h2></div>
        <dl class="detail-grid">
            <dt>Encryption</dt>
            <dd>@Model.Algorithm (envelope)</dd>

            <dt>Created (UTC)</dt>
            <dd>@Model.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</dd>

            <dt>Updated (UTC)</dt>
            <dd>@(Model.UpdatedAtUtc?.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</dd>

            <dt>Expires (UTC)</dt>
            <dd>@(Model.ExpiresAtUtc?.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss") ?? "never")</dd>

            <dt>Revisions</dt>
            <dd>@Model.Versions.Count archived</dd>
        </dl>

        <div class="danger-zone">
            <div>
                <strong>Delete this secret</strong>
                <p class="muted">Removes the value and all its versions permanently. The deletion is audited.</p>
            </div>
            <form class="inline-form" asp-action="Delete" asp-route-id="@Model.Id" method="post"
                  data-confirm="Delete '@Model.Name' and its entire version history permanently? This cannot be undone and will be audited.">
                <button type="submit" class="button danger">Delete</button>
            </form>
        </div>
    </section>
</div>

@if (Model.CanShare)
{
    <section class="panel">
        <div class="panel-header"><h2>Sharing</h2></div>
        <p class="muted">
            Grant a specific person access to this secret even though it is outside their
            project. A grant crosses the project boundary only — they still need adequate
            clearance and must meet the network/time rules.
        </p>

        <form class="add-network-form" asp-action="Grant" method="post">
            <input type="hidden" name="SecretId" value="@Model.Id" />
            <input name="GranteeUsernameOrEmail" placeholder="username or email" aria-label="User to share with" required />
            <input name="TtlDays" type="number" min="0" max="3650" value="0" class="input-narrow" aria-label="Access expires in days" title="Access expires in days (0 = no expiry)" />
            <button type="submit" class="button primary">Share access</button>
        </form>

        @if (Model.Grants.Count == 0)
        {
            <p class="muted">This secret is not shared with anyone.</p>
        }
        else
        {
            <table class="data-table">
                <thead><tr><th>User</th><th>Shared by</th><th>Since (UTC)</th><th>Expires (UTC)</th><th></th></tr></thead>
                <tbody>
                    @foreach (var g in Model.Grants)
                    {
                        <tr>
                            <td class="mono cell-strong">@g.GranteeUsername</td>
                            <td class="muted">@g.GrantedBy</td>
                            <td class="muted">@g.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="muted">@(g.ExpiresAtUtc?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "no expiry")</td>
                            <td class="cell-actions">
                                <form class="inline-form" asp-action="RevokeGrant" asp-route-id="@Model.Id" asp-route-grantId="@g.Id" method="post"
                                      data-confirm="Revoke @g.GranteeUsername's access to '@Model.Name'?">
                                    <button type="submit" class="button small danger">Revoke</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

<section class="panel">
    <div class="panel-header"><h2>Version history</h2></div>
    @if (Model.Versions.Count == 0)
    {
        <p class="muted">No previous values. When you rotate this secret, the value it replaces is archived here.</p>
    }
    else
    {
        <ul class="timeline">
            @foreach (var v in Model.Versions)
            {
                <li class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-body">
                        <div class="timeline-head">
                            <span class="cell-strong">Version @v.VersionNumber</span>
                            <span class="activity-meta">archived @AuditDisplay.Ago(v.ArchivedAtUtc, now) · by @v.ArchivedBy</span>
                        </div>
                        @if (!string.IsNullOrEmpty(v.ChangeNote))
                        {
                            <p class="muted timeline-note">@v.ChangeNote</p>
                        }
                        <div class="timeline-actions">
                            <form class="inline-form" asp-action="RevealVersion" asp-route-id="@Model.Id" asp-route-versionId="@v.Id" method="post">
                                <button type="submit" class="button small">Reveal</button>
                            </form>
                            <form class="inline-form" asp-action="RestoreVersion" asp-route-id="@Model.Id" asp-route-versionId="@v.Id" method="post"
                                  data-confirm="Restore version @v.VersionNumber as the live value? The current value will be archived first.">
                                <button type="submit" class="button small">Restore</button>
                            </form>
                        </div>
                    </div>
                </li>
            }
        </ul>
    }
</section>
