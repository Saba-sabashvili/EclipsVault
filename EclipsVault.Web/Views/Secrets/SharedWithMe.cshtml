@using EclipsVault.Web.Extensions
@model IReadOnlyList<SharedSecretDto>
@{
    ViewData["Title"] = "Shared with me";
}

<div class="page-header">
    <div>
        <h1>Shared with me</h1>
        <p class="page-sub">Secrets outside your project that someone has granted you access to.</p>
    </div>
</div>

<section class="panel">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyState {
            Icon = "share",
            Title = "Nothing shared with you yet",
            Message = "This is where secrets from other projects show up when a colleague grants you access to them. There's nothing for you to do here until someone shares one.",
            ActionText = "Go to your secrets", ActionController = "Secrets", ActionAction = "Index" })" />
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Project</th>
                        <th>Environment</th>
                        <th>Sensitivity</th>
                        <th>Shared by</th>
                        <th>Access until</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="mono cell-strong">@s.Name</td>
                            <td>@s.ProjectKey</td>
                            <td><span class="badge env-@s.Environment.ToString().ToLowerInvariant()">@s.Environment</span></td>
                            <td><span class="badge sens-@((int)s.Sensitivity)">@s.Sensitivity.ToDisplayName()</span></td>
                            <td class="muted">@s.GrantedBy</td>
                            <td class="muted">@(s.ExpiresAtUtc?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "no expiry")</td>
                            <td class="cell-actions"><a class="button small" asp-action="Details" asp-route-id="@s.SecretId">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
