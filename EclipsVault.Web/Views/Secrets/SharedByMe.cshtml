@model IReadOnlyList<OutgoingShareDto>
@{
    ViewData["Title"] = "Shared by me";
    var now = DateTimeOffset.UtcNow;
}

<div class="page-header">
    <div>
        <h1>Shared by me</h1>
        <p class="page-sub">
            Everyone you've granted access to one of your secrets. Review it now and then — if someone
            no longer needs a secret, revoke it. Revoking takes effect on their next request.
        </p>
    </div>
</div>

<section class="panel">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyState {
            Icon = "share",
            Title = "You haven't shared anything",
            Message = "When you grant a colleague access to one of your secrets, it shows up here so you can keep track of who can see what — and revoke access when it's no longer needed.",
            ActionText = "Go to your secrets", ActionController = "Secrets", ActionAction = "Index" })" />
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Secret</th>
                        <th>Shared with</th>
                        <th>Shared on</th>
                        <th>Access until</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var expired = s.ExpiresAtUtc is { } e && e <= now;
                        <tr>
                            <td class="mono cell-strong">@s.SecretName</td>
                            <td>@s.GranteeUsername</td>
                            <td class="muted">@s.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="muted">
                                @if (s.ExpiresAtUtc is { } exp)
                                {
                                    <span>@exp.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</span>
                                }
                                else
                                {
                                    <span>no expiry</span>
                                }
                            </td>
                            <td class="cell-actions">
                                <form asp-action="RevokeSharedByMe" method="post"
                                      data-confirm="Revoke @s.GranteeUsername's access to '@s.SecretName'? They lose access on their next request.">
                                    <input type="hidden" name="grantId" value="@s.GrantId" />
                                    <button type="submit" class="button small danger">Revoke</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
