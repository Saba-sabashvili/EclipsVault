@model EclipsVault.Web.Models.LicenseViewModel
@{
    ViewData["Title"] = "License";
    var statusTone = Model.Status switch
    {
        LicenseStatus.Valid => "ok",
        LicenseStatus.Expired => "warn",
        LicenseStatus.Missing => "muted",
        _ => "danger"
    };

    // A lapsed update window never disables anything — the licence is perpetual — so this is a
    // renewal nudge, computed against the current time rather than the startup snapshot.
    var updatesUntil = Model.Claims?.UpdatesUntilUtc;
    var updatesLapsed = updatesUntil is { } uu && uu < DateTimeOffset.UtcNow;
}

<div class="page-header">
    <div>
        <h1>License</h1>
        <p class="page-sub">How this vault is licensed. Licensing is soft — it never restricts the vault.</p>
    </div>
</div>

<section class="panel">
    <div class="panel-header">
        <h2>Status</h2>
        <span class="badge tone-@statusTone">@Model.Status</span>
    </div>
    <p class="hint muted">@Model.Message</p>

    @if (Model.Claims is { } c)
    {
        <dl class="detail-grid">
            <dt>Licensed to</dt><dd>@c.IssuedTo</dd>
            <dt>Tier</dt><dd>@c.Tier</dd>
            @if (!string.IsNullOrWhiteSpace(c.Contact))
            {
                <dt>Contact</dt><dd>@c.Contact</dd>
            }
            <dt>License id</dt><dd class="mono">@c.LicenseId</dd>
            <dt>Issued</dt><dd>@c.IssuedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'")</dd>
            <dt>Expires</dt>
            <dd>@(c.NotAfterUtc is { } exp ? exp.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'") : "never — perpetual")</dd>
            <dt>Updates included until</dt>
            <dd>@(updatesUntil?.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "—")</dd>
            <dt>Node allowance</dt>
            <dd>@(c.MaxNodes == 0 ? "unlimited" : c.MaxNodes.ToString())</dd>
        </dl>
    }

    @if (updatesLapsed)
    {
        <div class="notice notice-warn">
            <span>
                <strong>Your update window has ended.</strong> The vault keeps working and still
                receives security patches; renew to receive new feature releases.
            </span>
        </div>
    }

    @if (Model.PremiumFeaturesBeyondTier.Count > 0)
    {
        <div class="notice notice-warn">
            <span>
                <strong>In use beyond your tier:</strong> @string.Join(", ", Model.PremiumFeaturesBeyondTier).
                These keep working — licensing is soft — but are not covered by your current tier.
            </span>
        </div>
    }
</section>

<section class="panel">
    <div class="panel-header"><h2>Installing a license</h2></div>
    <p class="hint muted">
        Set the <code>ECLIPSVAULT_LICENSE</code> environment variable to your license token, or put the
        token in a <code>license.key</code> file in the app's content root, then restart. The token is
        verified offline against the vendor key pinned into this build — it never leaves your infrastructure.
    </p>
    <p class="hint muted">See the Pricing &amp; licensing section of the README to buy or renew.</p>
</section>
