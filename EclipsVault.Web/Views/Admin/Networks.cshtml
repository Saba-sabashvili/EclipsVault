@model NetworksViewModel
@{
    ViewData["Title"] = "Networks";
}

<div class="page-header">
    <div>
        <h1>Networks</h1>
        <p class="page-sub">Trusted source ranges for the ABAC network rule, and active intrusion-defence blocks.</p>
    </div>
</div>

<section class="panel highlight">
    <div class="current-ip">
        <div>
            <span class="stat-label">Your current address, as the vault sees it</span>
            <div class="current-ip-value">
                <code class="mono">@Model.CurrentIp</code>
                @if (Model.CurrentIpTrusted)
                {
                    <span class="badge tone-ok">Trusted</span>
                }
                else
                {
                    <span class="badge tone-warn">Not trusted</span>
                }
            </div>
            <p class="muted">
                On a VPN this is the VPN egress address. Confidential+ secrets are only
                readable from trusted ranges — if you switch networks, trust the new
                address here.
            </p>
        </div>
        @if (!Model.CurrentIpTrusted)
        {
            <form class="inline-form" asp-action="TrustCurrentIp" method="post">
                <button type="submit" class="button primary">Trust this address</button>
            </form>
        }
    </div>
</section>

<div class="two-col">
    <section class="panel">
        <div class="panel-header"><h2>Runtime trusted networks</h2></div>

        <form class="add-network-form" asp-action="AddNetwork" method="post">
            <input asp-for="AddForm.Cidr" name="Cidr" placeholder="203.0.113.7 or 10.8.0.0/24" aria-label="IP or CIDR" />
            <input asp-for="AddForm.Label" name="Label" placeholder="Label (e.g. Office VPN)" aria-label="Label" />
            <button type="submit" class="button primary">Trust</button>
        </form>

        @if (Model.DynamicNetworks.Count == 0)
        {
            <p class="muted">No runtime-trusted networks yet. Entries added here apply immediately and are audited.</p>
        }
        else
        {
            <table class="data-table">
                <thead><tr><th>Range</th><th>Label</th><th>Added by</th><th>Added (UTC)</th><th></th></tr></thead>
                <tbody>
                    @foreach (var network in Model.DynamicNetworks)
                    {
                        <tr>
                            <td class="mono cell-strong">@network.Cidr</td>
                            <td>@network.Label</td>
                            <td class="muted">@network.AddedBy</td>
                            <td class="muted">@network.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="cell-actions">
                                <form class="inline-form" asp-action="RemoveNetwork" asp-route-id="@network.Id" method="post"
                                      data-confirm="Stop trusting @network.Cidr? Requests from it will fail the network rule for Confidential+ secrets.">
                                    <button type="submit" class="button small danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <div class="stack">
        <section class="panel">
            <div class="panel-header"><h2>Configured ranges</h2></div>
            <p class="muted">Static ranges from <code>Abac:TrustedIpCidrs</code>; change them in configuration.</p>
            <ul class="cidr-list">
                @foreach (var cidr in Model.ConfiguredCidrs)
                {
                    <li class="mono">@cidr</li>
                }
            </ul>
        </section>

        <section class="panel">
            <div class="panel-header"><h2>Intrusion-defence blocks</h2></div>
            @if (Model.BlockedRanges.Count == 0)
            {
                <p class="muted">No ranges are currently blocked.</p>
            }
            else
            {
                <table class="data-table">
                    <thead><tr><th>Range</th><th>Reason</th><th>Since (UTC)</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var blocked in Model.BlockedRanges)
                        {
                            <tr>
                                <td class="mono cell-strong">@blocked.Network</td>
                                <td class="muted">@blocked.Reason</td>
                                <td class="muted">@blocked.BlockedAtUtc.UtcDateTime.ToString("MM-dd HH:mm")</td>
                                <td class="cell-actions">
                                    <form class="inline-form" asp-action="Unblock" method="post"
                                          data-confirm="Lift the intrusion-defence block on @blocked.Network?">
                                        <input type="hidden" name="network" value="@blocked.Network" />
                                        <button type="submit" class="button small">Unblock</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    </div>
</div>
