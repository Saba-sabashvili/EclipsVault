@model KekStatus
@{
    ViewData["Title"] = "Encryption keys";

    (string cls, string label) KekBadge(KekUsage u)
    {
        if (u.IsCurrent) return ("tone-ok", "current");
        if (u.IsKnown) return ("tone-warn", "retired");
        return ("tone-danger", "not loaded");
    }
}

<div class="page-header">
    <div>
        <h1>Encryption keys</h1>
        <p class="page-sub">Each secret's data key is wrapped by a master KEK. Rotation re-wraps every secret under the current KEK and retires the old one — the payload itself is never re-encrypted.</p>
    </div>
</div>

@if (Model.Usage.Any(u => !u.IsCurrent && !u.IsKnown))
{
    <div class="notice notice-critical">
        <strong>⚠ Some secrets reference a KEK that is not loaded.</strong>
        <span>Provide the missing key as a retired KEK (<code>ECLIPSVAULT_KEK_RETIRED</code>) so it can be decrypted and rotated, or those secrets cannot be read.</span>
    </div>
}
else if (Model.PendingRewrap > 0)
{
    <div class="notice notice-warn">
        <strong>@Model.PendingRewrap item(s) are still on a retired KEK.</strong>
        <span>Run a rotation to re-wrap them under the current key, then the retired key can be removed.</span>
    </div>
}
else
{
    <div class="notice notice-ok">
        <strong>✓ All secrets are wrapped under the current KEK.</strong>
        <span>Nothing to rotate.</span>
    </div>
}

<div class="two-col">
    <section class="panel">
        <div class="panel-header"><h2>Keys in use</h2></div>
        <div class="table-scroll">
            <table class="data-table">
                <thead><tr><th>KEK id</th><th>Status</th><th>Secrets</th><th>Versions</th></tr></thead>
                <tbody>
                    @foreach (var u in Model.Usage)
                    {
                        var badge = KekBadge(u);
                        <tr>
                            <td class="mono cell-strong">@u.KekId</td>
                            <td><span class="badge @badge.cls">@badge.label</span></td>
                            <td>@u.SecretCount</td>
                            <td>@u.VersionCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header"><h2>Rotate</h2></div>
        <dl class="detail-grid">
            <dt>Current KEK</dt>
            <dd class="mono">@Model.CurrentKekId</dd>
            <dt>Keys loaded</dt>
            <dd class="mono">@string.Join(", ", Model.KnownKekIds)</dd>
            <dt>Awaiting rotation</dt>
            <dd>@Model.PendingRewrap item(s)</dd>
        </dl>
        <p class="hint muted">
            To rotate: generate a new key, set it as <code>ECLIPSVAULT_KEK</code>, move the previous key to
            <code>ECLIPSVAULT_KEK_RETIRED</code>, restart, then run the rotation below. Once it completes,
            the retired key can be removed.
        </p>
        <form asp-action="Rotate" method="post"
              data-confirm="Re-wrap every secret's data key under the current KEK now? This is safe and can be repeated.">
            <button type="submit" class="button primary" @(Model.PendingRewrap == 0 ? "disabled" : "")>
                Re-wrap under current KEK
            </button>
        </form>
    </section>
</div>
