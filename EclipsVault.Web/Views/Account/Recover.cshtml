@model RecoverViewModel
@{
    ViewData["Title"] = "Recover access";
    Layout = "_AuthLayout";
}

<section class="auth-card">
    <h1>Recover access</h1>
    <p class="muted">
        Administrator break-glass recovery. Enter all of your credentials in one
        step — if they verify and your account holds TopSecret clearance, the
        intrusion-defence block on your network is lifted and your session restored.
        Every attempt is audited.
    </p>

    <form asp-action="Recover" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field">
            <label asp-for="Username"></label>
            <input asp-for="Username" autocomplete="username" autofocus />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Code"></label>
            <input asp-for="Code" class="code-input" inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
            <span asp-validation-for="Code" class="field-error"></span>
        </div>

        <button type="submit" class="button primary wide">Verify and restore access</button>
    </form>

    <p class="footnote">
        Not an administrator? Ask one to lift the block from Admin → Networks, or
        restart the application in development.
    </p>
</section>
