@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<section class="auth-card">
    <div class="step-track" aria-hidden="true"><span class="step active"></span><span class="step"></span></div>
    <h1>Sign in</h1>
    <p class="muted">Step 1 of 2 — password. An authenticator code is always required next.</p>

    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field">
            <label asp-for="Username"></label>
            <input asp-for="Username" autocomplete="username" autofocus />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <button type="submit" class="button primary wide">Continue</button>
    </form>

    <div class="auth-divider" data-passkey-panel><span>or</span></div>
    <button type="button" class="button wide" data-passkey-login data-username="#Username">
        Sign in with a passkey
    </button>
    <p class="passkey-status" data-passkey-status role="status" aria-live="polite"></p>
</section>
