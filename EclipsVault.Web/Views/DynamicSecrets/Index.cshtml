@using EclipsVault.Web.Extensions
@model DynamicSecretsViewModel
@{
    ViewData["Title"] = "Dynamic secrets";
}

<div class="page-header">
    <div>
        <h1>Dynamic secrets</h1>
        <p class="page-sub">
            Credentials the vault creates on a real backend when you ask, and destroys when the lease
            elapses. Nothing is stored — the value is shown once and cannot be recovered.
        </p>
    </div>
</div>

@if (Model.Issued is { } issued)
{
    <section class="panel highlight">
        <div class="panel-header"><h2>Your new credential — shown once</h2></div>
        <p class="muted">
            The vault kept no copy of this password. Close or reload this page and it is gone for good;
            you would need to issue a new one. It stops working at
            <strong>@issued.ExpiresAtUtc.ToString("u")</strong>, whether or not you are still using it.
        </p>
        <table class="data-table">
            <tbody>
                <tr><th scope="row">Role</th><td>@issued.RoleName</td></tr>
                <tr><th scope="row">Username</th><td><code class="mono">@issued.Identity</code></td></tr>
                <tr><th scope="row">Password</th><td><code class="mono">@issued.Secret</code></td></tr>
                <tr><th scope="row">Lease ends (UTC)</th><td>@issued.ExpiresAtUtc.ToString("u")</td></tr>
            </tbody>
        </table>
    </section>
}

<section class="panel">
    <div class="panel-header"><h2>Roles you can issue</h2></div>

    @if (Model.Roles.Count == 0)
    {
        <p class="muted">
            No dynamic-secret roles are available to you. Roles are gated by the same clearance,
            project, network, and time rules as stored secrets.
        </p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Role</th><th>Backend</th><th>Project</th><th>Environment</th>
                    <th>Sensitivity</th><th>Lease</th><th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var role in Model.Roles)
            {
                <tr>
                    <td>
                        <strong>@role.Name</strong>
                        <div class="muted">@role.Description</div>
                    </td>
                    <td>@role.Backend</td>
                    <td>@role.ProjectKey</td>
                    <td>@role.Environment</td>
                    <td>@role.Sensitivity.ToDisplayName()</td>
                    <td>@role.DefaultTtlMinutes min <span class="muted">(max @role.MaxTtlMinutes)</span></td>
                    <td>
                        <form class="inline-form" asp-action="Issue" method="post">
                            <input type="hidden" name="RoleId" value="@role.Id" />
                            <input type="number" name="TtlMinutes" min="1" max="@role.MaxTtlMinutes"
                                   placeholder="@role.DefaultTtlMinutes" aria-label="Lease minutes for @role.Name" />
                            <button type="submit" class="button primary">Generate</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

<section class="panel">
    <div class="panel-header">
        <h2>@(Model.ShowingEveryone ? "All leases" : "Your leases")</h2>
    </div>

    @if (Model.Leases.Count == 0)
    {
        <p class="muted">No credentials issued yet.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Role</th><th>Username</th>
                    @if (Model.ShowingEveryone)
                    {
                        <th>Taken by</th>
                    }
                    <th>Issued (UTC)</th><th>Lease ends (UTC)</th><th>Status</th><th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var lease in Model.Leases)
            {
                <tr>
                    <td>@lease.RoleName</td>
                    <td><code class="mono">@lease.CredentialIdentity</code></td>
                    @if (Model.ShowingEveryone)
                    {
                        <td>@lease.Username</td>
                    }
                    <td>@lease.IssuedAtUtc.ToString("u")</td>
                    <td>@lease.ExpiresAtUtc.ToString("u")</td>
                    <td>
                        @switch (lease.Status)
                        {
                            case LeaseStatus.Active:
                                <span class="badge tone-ok">Active</span>
                                break;
                            case LeaseStatus.Expired:
                                <span class="badge">Expired</span>
                                break;
                            case LeaseStatus.Revoked:
                                <span class="badge">Revoked</span>
                                break;
                            case LeaseStatus.RevocationFailed:
                                <span class="badge tone-bad">Revocation failed</span>
                                <div class="muted">@lease.RevocationError</div>
                                break;
                        }
                    </td>
                    <td>
                        @if (lease.Status == LeaseStatus.Active)
                        {
                            <form class="inline-form" asp-action="Revoke" method="post">
                                <input type="hidden" name="id" value="@lease.Id" />
                                <button type="submit" class="button danger"
                                        data-confirm="Hand back '@lease.CredentialIdentity'? It stops working immediately.">
                                    Revoke
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
