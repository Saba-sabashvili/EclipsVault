@model NotificationsViewModel
@{
    ViewData["Title"] = "Notifications";

    (string cls, string label) StatusBadge(EmailDeliveryStatus s) => s switch
    {
        EmailDeliveryStatus.Sent => ("tone-ok", "Sent"),
        EmailDeliveryStatus.Failed => ("tone-danger", "Failed"),
        _ => ("tone-muted", "Suppressed")
    };
}

<div class="page-header">
    <div>
        <h1>Notifications</h1>
        <p class="page-sub">Every email the vault composed and tried to deliver, newest first. This is a delivery record, not a mailbox.</p>
    </div>
</div>

<div class="notice @(!Model.Enabled ? "notice-warn" : Model.IsSmtp ? "notice-ok" : "notice-warn")">
    @if (!Model.Enabled)
    {
        <strong>⚠ Delivery is off.</strong>
        <span>Notifications are recorded as <em>suppressed</em> and never sent. Set <code>Email:Enabled=true</code> to dispatch them.</span>
    }
    else if (Model.IsSmtp)
    {
        <strong>✓ Delivering via SMTP → <span class="mono">@Model.SmtpTarget</span>.</strong>
        <span>Composed emails are sent to your mail server and recorded below.</span>
    }
    else
    {
        <strong>Development log transport.</strong>
        <span>Emails are composed and recorded below but <strong>not actually sent</strong>. Point <code>Email:Sender=Smtp</code> at an SMTP server (e.g. the bundled Mailpit) to deliver them.</span>
    }
</div>

<section class="panel">
    <div class="panel-header">
        <h2>Outbox</h2>
        <input type="search" class="table-search" placeholder="Filter by recipient, subject, event…" data-filter="#outbox" aria-label="Filter notifications" />
    </div>

    @if (Model.Outbox.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyState {
            Icon = "mail",
            Title = "No notifications sent yet",
            Message = "Domain events send email automatically — approving or rejecting an access request, a password change, or provisioning a user. Each one is recorded here with its delivery outcome." })" />
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table" id="outbox">
                <thead>
                    <tr><th>Sent (UTC)</th><th>To</th><th>Subject</th><th>Event</th><th>Transport</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Outbox)
                    {
                        var badge = StatusBadge(e.Status);
                        <tr>
                            <td class="muted">@e.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="mono">@e.ToAddress</td>
                            <td class="cell-strong" title="@e.Body">@e.Subject</td>
                            <td><span class="badge tone-muted">@e.EventType</span></td>
                            <td class="muted">@e.Transport</td>
                            <td>
                                <span class="badge @badge.cls">@badge.label</span>
                                @if (e.Status == EmailDeliveryStatus.Failed && !string.IsNullOrEmpty(e.Error))
                                {
                                    <span class="hint muted" title="@e.Error"> ⚠</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
