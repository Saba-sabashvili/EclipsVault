@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
    var avatarUrl = Url.Action("Avatar", "Profile", new { v = DateTimeOffset.UtcNow.Ticks });
}

<div class="page-header">
    <div>
        <h1>Profile</h1>
        <p class="page-sub">Manage how you appear and how you sign in. Every change is audited.</p>
    </div>
</div>

<div class="two-col">
    <div class="stack">
        <section class="panel">
            <div class="panel-header"><h2>Profile picture</h2></div>
            <div class="avatar-editor">
                <img class="avatar-lg" src="@avatarUrl" alt="Your avatar" width="96" height="96" />
                <div class="avatar-editor-actions">
                    <form asp-action="UploadAvatar" method="post" enctype="multipart/form-data" data-autosubmit="#avatar-file">
                        <input type="file" id="avatar-file" name="avatar" accept="image/png,image/jpeg" class="visually-hidden" />
                        <label for="avatar-file" class="button">Upload image</label>
                    </form>
                    @if (Model.HasCustomAvatar)
                    {
                        <form asp-action="RemoveAvatar" method="post" data-confirm="Remove your profile picture and go back to the generated avatar?">
                            <button type="submit" class="button danger">Remove</button>
                        </form>
                    }
                    <p class="hint muted">JPEG or PNG, up to 4 MB. Images are cropped to a square, resized, and stripped of metadata.</p>
                </div>
            </div>
        </section>

        <section class="panel">
            <div class="panel-header"><h2>Details</h2></div>
            <form asp-action="Update" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="field">
                    <label>Username</label>
                    <input value="@Model.Username" disabled />
                    <span class="hint muted">Your login identity and audit anchor — fixed for accountability.</span>
                </div>

                <div class="field">
                    <label asp-for="DisplayName"></label>
                    <input asp-for="DisplayName" autocomplete="name" />
                    <span asp-validation-for="DisplayName" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <button type="submit" class="button primary">Save changes</button>
            </form>
        </section>
    </div>

    <div class="stack">
        <section class="panel">
            <div class="panel-header"><h2>Access</h2></div>
            <dl class="detail-grid">
                <dt>Clearance</dt>
                <dd><span class="badge sens-@((int)Model.Clearance)">@Model.Clearance</span></dd>
                <dt>Project</dt>
                <dd>@Model.ProjectKey</dd>
            </dl>
            <p class="hint muted">Clearance and project are set by an administrator. Ask one if these need to change.</p>
        </section>

        <section class="panel">
            <div class="panel-header"><h2>Security</h2></div>

            <div class="settings-row">
                <div>
                    <strong>Password</strong>
                    <p class="muted">Argon2id-hashed. Change it periodically.</p>
                </div>
                <a class="button" asp-action="ChangePassword">Change password</a>
            </div>

            <div class="settings-row">
                <div>
                    <strong>Authenticator (2FA)</strong>
                    <p class="muted">
                        @(Model.TotpEnabled ? "Enrolled." : "Not yet enrolled.")
                        Reset if you switched phones or lost access.
                    </p>
                </div>
                <form asp-action="ResetMfa" method="post"
                      data-confirm="Reset your authenticator? You'll be signed out and set up a new one at next sign-in.">
                    <button type="submit" class="button">Reset authenticator</button>
                </form>
            </div>

            <div class="settings-row">
                <div>
                    <strong>Recovery codes</strong>
                    <p class="muted">
                        Single-use codes to sign in if you lose your authenticator.
                        @if (Model.RecoveryCodesRemaining > 0)
                        {
                            <text><strong>@Model.RecoveryCodesRemaining</strong> unused code@(Model.RecoveryCodesRemaining == 1 ? "" : "s") left.</text>
                        }
                        else
                        {
                            <text>None generated yet.</text>
                        }
                    </p>
                </div>
                <form asp-action="GenerateRecoveryCodes" method="post"
                      data-confirm="Generate a new set of recovery codes? Any codes you already have will immediately stop working.">
                    <button type="submit" class="button">@(Model.RecoveryCodesRemaining > 0 ? "Regenerate" : "Generate codes")</button>
                </form>
            </div>

            <div class="settings-row">
                <div>
                    <strong>Sessions</strong>
                    <p class="muted">Sign out of every device, including this one.</p>
                </div>
                <form asp-action="SignOutEverywhere" method="post"
                      data-confirm="Sign out of all sessions now? You'll need to sign in again.">
                    <button type="submit" class="button danger">Sign out everywhere</button>
                </form>
            </div>
        </section>

        <section class="panel" data-passkey-panel>
            <div class="panel-header"><h2>Passkeys</h2></div>
            <p class="hint muted">
                Sign in without a password using Touch ID, Windows Hello, or a security key.
                A passkey verifies you on your device, so it stands in for both your password and your authenticator.
            </p>

            @Html.AntiForgeryToken()

            @if (Model.Passkeys.Count > 0)
            {
                foreach (var passkey in Model.Passkeys)
                {
                    <div class="settings-row">
                        <div>
                            <strong>@passkey.Nickname</strong>
                            <p class="muted">Added @passkey.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</p>
                        </div>
                        <form asp-action="RemovePasskey" method="post"
                              data-confirm="Remove this passkey? You will no longer be able to sign in with it.">
                            <input type="hidden" name="id" value="@passkey.Id" />
                            <button type="submit" class="button danger">Remove</button>
                        </form>
                    </div>
                }
            }
            else
            {
                <p class="hint muted">No passkeys registered yet.</p>
            }

            <div class="field passkey-add">
                <label for="passkey-nickname">New passkey name</label>
                <input id="passkey-nickname" type="text" maxlength="64" autocomplete="off"
                       placeholder="e.g. MacBook Touch ID" />
            </div>
            <button type="button" class="button primary" data-passkey-register data-nickname="#passkey-nickname">
                Add a passkey
            </button>
            <p class="passkey-status" data-passkey-status role="status" aria-live="polite"></p>
        </section>
    </div>
</div>
