@{
    ViewData["Title"] = "Welcome";
    Layout = "_AuthLayout";
}

<section class="auth-card landing">
    <h1>Secrets, kept in the shadow.</h1>
    <p class="muted">
        EclipsVault protects credentials with AES-256-GCM envelope encryption,
        Argon2id staff authentication, mandatory multi-factor sign-in,
        attribute-based access control and a fail-closed, immutable audit trail.
    </p>
    <ul class="landing-points">
        <li>Every reveal is audited before decryption — no audit, no plaintext.</li>
        <li>Honey-token decoys trip an automatic intrusion response.</li>
        <li>Expired secrets are shredded automatically at TTL.</li>
    </ul>
    <a class="button primary wide" asp-controller="Account" asp-action="Login">Sign in to the vault</a>
</section>
