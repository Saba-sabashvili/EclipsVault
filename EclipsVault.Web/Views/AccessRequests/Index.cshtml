@model AccessRequestsViewModel
@{
    ViewData["Title"] = "Access requests";

    (string cls, string label) StatusBadge(AccessRequestStatus s) => s switch
    {
        AccessRequestStatus.Pending => ("tone-warn", "Pending"),
        AccessRequestStatus.Approved => ("tone-ok", "Approved"),
        AccessRequestStatus.Rejected => ("tone-danger", "Rejected"),
        _ => ("tone-muted", "Withdrawn")
    };
}

<div class="page-header">
    <div>
        <h1>Access requests</h1>
        <p class="page-sub">Request access to a secret you were denied, and review requests you can approve.</p>
    </div>
</div>

<section class="panel">
    <div class="panel-header">
        <h2>To review</h2>
        <span class="muted">@(Model.CanReviewAll ? "All projects" : "Your project")</span>
    </div>

    @if (Model.ToReview.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyState {
            Icon = "clipboard",
            Title = "Nothing waiting on you",
            Message = "When someone requests access to a secret you can share, it lands here for you to approve or reject." })" />
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr><th>Secret</th><th>Requester</th><th>Reason</th><th>Denied because</th><th>Requested</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.ToReview)
                    {
                        <tr>
                            <td class="cell-strong">@r.SecretName <span class="badge tone-muted">@r.ProjectKey</span></td>
                            <td>@r.RequesterUsername</td>
                            <td class="muted">@r.Reason</td>
                            <td class="muted">@(r.DeniedReasons ?? "—")</td>
                            <td class="muted">@r.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="cell-actions">
                                <form class="inline-form review-approve" asp-action="Approve" asp-route-id="@r.Id" method="post">
                                    <input name="ttlDays" type="number" min="0" max="3650" value="0" title="Grant expires in days (0 = no expiry)" aria-label="Grant expiry in days" />
                                    <button type="submit" class="button small primary">Approve</button>
                                </form>
                                <form class="inline-form" asp-action="Reject" asp-route-id="@r.Id" method="post"
                                      data-confirm="Reject @r.RequesterUsername's request for @r.SecretName?">
                                    <button type="submit" class="button small danger">Reject</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel">
    <div class="panel-header"><h2>My requests</h2></div>

    @if (Model.Mine.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyState {
            Icon = "inbox",
            Title = "You haven't requested any access",
            Message = "If you're denied a secret outside your clearance or project, its page offers a \"Request access\" button — your requests and their decisions then show up here.",
            ActionText = "Browse secrets", ActionController = "Secrets", ActionAction = "Index" })" />
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr><th>Secret</th><th>Status</th><th>Requested</th><th>Decision</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Mine)
                    {
                        var badge = StatusBadge(r.Status);
                        <tr>
                            <td class="cell-strong">@r.SecretName <span class="badge tone-muted">@r.ProjectKey</span></td>
                            <td><span class="badge @badge.cls">@badge.label</span></td>
                            <td class="muted">@r.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="muted">
                                @if (r.DecidedAtUtc is { } decided)
                                {
                                    <span>@r.DecidedBy · @decided.UtcDateTime.ToString("yyyy-MM-dd")</span>
                                    @if (!string.IsNullOrEmpty(r.DecisionNote))
                                    {
                                        <span> — @r.DecisionNote</span>
                                    }
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                            <td class="cell-actions">
                                @if (r.Status == AccessRequestStatus.Pending)
                                {
                                    <form class="inline-form" asp-action="Cancel" asp-route-id="@r.Id" method="post"
                                          data-confirm="Withdraw your request for @r.SecretName?">
                                        <button type="submit" class="button small">Withdraw</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
