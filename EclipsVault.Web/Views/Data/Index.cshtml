@model DataExportViewModel
@{
    ViewData["Title"] = "Your data";
    var a = Model.Account;
}

<div class="page-header">
    <div>
        <h1>Your data</h1>
        <p class="page-sub">
            Everything EclipsVault holds about your account, in one place. Download a portable copy
            for your records — or just to see what's stored. Only <em>your</em> data is included.
        </p>
    </div>
    <form asp-action="Download" method="post">
        <button type="submit" class="button primary">Download (JSON)</button>
    </form>
</div>

<section class="panel">
    <div class="panel-header"><h2>Account</h2></div>
    <dl class="detail-grid">
        <dt>Username</dt><dd class="mono">@a.Username</dd>
        <dt>Display name</dt><dd>@a.DisplayName</dd>
        <dt>Email</dt><dd>@a.Email</dd>
        <dt>Clearance</dt><dd>@a.Clearance</dd>
        <dt>Project</dt><dd>@a.ProjectKey</dd>
        <dt>Profile picture</dt><dd>@(a.HasCustomAvatar ? "Custom image" : "Generated identicon")</dd>
    </dl>
</section>

<section class="panel">
    <div class="panel-header"><h2>What's included</h2></div>
    <div class="stat-grid">
        <div class="stat-card">
            <span class="stat-value">@(Model.TwoStepEnabled ? "On" : "Off")</span>
            <span class="stat-label">Two-step sign-in</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">@Model.PasskeyCount</span>
            <span class="stat-label">Passkeys</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">@Model.BackupCodesRemaining</span>
            <span class="stat-label">Backup codes left</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">@Model.DeviceCount</span>
            <span class="stat-label">Signed-in devices</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">@Model.AccessRequestCount</span>
            <span class="stat-label">Access requests filed</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">@Model.ActivityCount</span>
            <span class="stat-label">Recent activity entries</span>
        </div>
    </div>
</section>

<section class="panel">
    <p class="muted">@Model.Notice</p>
    <form asp-action="Download" method="post">
        <button type="submit" class="button primary">Download a copy of my data (JSON)</button>
    </form>
</section>
