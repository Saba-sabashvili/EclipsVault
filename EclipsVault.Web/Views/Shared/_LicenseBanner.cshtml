@inject EclipsVault.Web.Services.LicenseNudgeState Nudge
@* A standing notice, not a toast: no data-flash, so site.js never auto-dismisses it. Rendered only
   for admins (see _Layout) — the only people who can act on it. *@
@if (Nudge.ShowBanner)
{
    <div class="notice notice-warn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
        @if (Nudge.Status != LicenseStatus.Valid)
        {
            <span>
                <strong>Running unlicensed.</strong> @Nudge.Message This changes nothing about how the vault runs — it only affects this notice.
                <a asp-controller="License" asp-action="Index">View license</a>
            </span>
        }
        else
        {
            <span>
                <strong>Premium features beyond your tier.</strong>
                In use but not covered by your license: @string.Join(", ", Nudge.PremiumFeaturesBeyondTier).
                <a asp-controller="License" asp-action="Index">View license</a>
            </span>
        }
    </div>
}
