@{
    var theme = Context.Request.Cookies["EclipsVault.Theme"] == "light" ? "light" : "dark";
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — EclipsVault</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body class="auth-body">
    <div class="auth-theme-toggle">
        <partial name="_ThemeToggle" />
    </div>
    <main class="auth-wrap">
        <a class="brand auth-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-name">EclipsVault</span>
        </a>
        <partial name="_Flash" />
        @RenderBody()
        <p class="auth-footnote">Envelope-encrypted secret management. Everything is audited.</p>
    </main>
</body>
</html>
