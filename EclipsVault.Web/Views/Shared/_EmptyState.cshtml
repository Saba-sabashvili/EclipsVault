@model EmptyState
<div class="empty-state">
    <div class="empty-icon">@Html.Raw(EmptyStateIcons.Svg(Model.Icon))</div>
    <h3>@Model.Title</h3>
    <p>@Model.Message</p>
    @if (Model.HasAction)
    {
        <a class="button primary" asp-controller="@Model.ActionController" asp-action="@Model.ActionAction">@Model.ActionText</a>
    }
</div>
