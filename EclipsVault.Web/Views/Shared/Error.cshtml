@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="page-header">
    <div>
        <h1>@Model.Code — @Model.Title</h1>
        <p class="page-sub">@Model.Message</p>
    </div>
</div>

<section class="panel narrow-left">
    @if (Model.RequestId is not null)
    {
        <p class="muted">Request id: <code>@Model.RequestId</code></p>
    }
    <a class="button" asp-controller="Home" asp-action="Index">Back to safety</a>
</section>
