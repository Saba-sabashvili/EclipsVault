@model ActivityIndexViewModel
@{
    ViewData["Title"] = "My activity";
    var feed = Model.Feed;
    var now = DateTimeOffset.UtcNow;
}

<div class="page-header">
    <div>
        <h1>My activity</h1>
        <p class="page-sub">
            Everything you have done in EclipsVault, newest first — sign-ins, secret reveals, and
            account changes. Only your own actions appear here. Spot something you don't recognise?
            <a asp-controller="Profile" asp-action="Index">Change your password or sign out everywhere</a>.
        </p>
    </div>
    @if (feed.NotableCount > 0)
    {
        <span class="badge tone-warn" title="Notable or higher-severity entries on this page">
            @feed.NotableCount notable
        </span>
    }
</div>

@if (feed.Items.Count == 0)
{
    @if (feed.HasPrevious)
    {
        <section class="panel">
            <p class="muted">Nothing further back to show.</p>
            <a class="button" asp-action="Index">Back to latest</a>
        </section>
    }
    else
    {
        <partial name="_EmptyState" model="@(new EmptyState
               {
                   Icon = "clipboard",
                   Title = "No activity yet",
                   Message = "As you sign in, view and reveal secrets, and update your account, each action is recorded here so you can review it later."
               })" />
    }
}
else
{
    <section class="panel">
        <ul class="activity-feed">
            @foreach (var item in feed.Items)
            {
                <li class="feed-item sev-@ActivityDisplay.Tone(item.Severity)">
                    <span class="feed-icon">@ActivityDisplay.Icon(item.Category)</span>
                    <div class="feed-body">
                        <div class="feed-title-row">
                            <span class="feed-title">@item.Title</span>
                            <span class="badge tone-muted">@ActivityDisplay.Label(item.Category)</span>
                            @if (!string.IsNullOrWhiteSpace(item.ResourceName))
                            {
                                <span class="mono muted feed-resource" title="@item.ResourceName">@item.ResourceName</span>
                            }
                        </div>
                        <div class="feed-meta">
                            <span class="mono">from @item.SourceIp</span>
                        </div>
                    </div>
                    <time class="feed-time" title="@item.TimestampUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")">
                        @ActivityDisplay.Ago(item.TimestampUtc, now)
                    </time>
                </li>
            }
        </ul>
    </section>

    @if (feed.HasPrevious || feed.HasMore)
    {
        <nav class="pager" aria-label="Activity pages">
            <div class="pager-side">
                @if (feed.HasPrevious)
                {
                    <a class="button" asp-action="Index" asp-route-page="@(feed.Page - 1)">← Newer</a>
                }
            </div>
            <span class="pager-page">Page @feed.Page</span>
            <div class="pager-side">
                @if (feed.HasMore)
                {
                    <a class="button" asp-action="Index" asp-route-page="@(feed.Page + 1)">Older →</a>
                }
            </div>
        </nav>
    }
}
