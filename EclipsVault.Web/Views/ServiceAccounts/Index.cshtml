@model IReadOnlyList<ServiceAccountSummaryDto>
@{
    ViewData["Title"] = "Service accounts";
}

<div class="page-header">
    <div>
        <h1>Service accounts</h1>
        <p class="page-sub">Non-interactive identities that retrieve secrets over the API using API keys.</p>
    </div>
    <div class="page-actions">
        <a class="button primary" asp-action="Create">New service account</a>
    </div>
</div>

<section class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <p><strong>No service accounts yet.</strong></p>
            <p class="muted">Create one to give an application programmatic, ABAC-governed access to secrets.</p>
            <a class="button primary" asp-action="Create">New service account</a>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Clearance</th>
                        <th>Project</th>
                        <th>Active keys</th>
                        <th>Status</th>
                        <th>Created (UTC)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr class="@(a.IsDisabled ? "row-muted" : "")">
                            <td class="mono cell-strong">@a.Name</td>
                            <td><span class="badge sens-@((int)a.Clearance)">@a.Clearance</span></td>
                            <td>@a.ProjectKey</td>
                            <td>@a.ActiveKeyCount</td>
                            <td>
                                @if (a.IsDisabled)
                                {
                                    <span class="badge tone-danger">Disabled</span>
                                }
                                else
                                {
                                    <span class="badge tone-ok">Active</span>
                                }
                            </td>
                            <td class="muted">@a.CreatedAtUtc.UtcDateTime.ToString("yyyy-MM-dd")</td>
                            <td class="cell-actions"><a class="button small" asp-action="Details" asp-route-id="@a.Id">Manage</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
