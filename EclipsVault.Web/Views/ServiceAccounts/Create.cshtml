@model CreateServiceAccountViewModel
@{
    ViewData["Title"] = "New service account";
}

<div class="page-header">
    <div>
        <h1>New service account</h1>
        <p class="page-sub">It gets the same ABAC attributes as a user — clearance and project — which decide what it can read.</p>
    </div>
    <div class="page-actions">
        <a class="button" asp-action="Index">Back</a>
    </div>
</div>

<section class="panel narrow-left">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field">
            <label asp-for="Name"></label>
            <input asp-for="Name" placeholder="phoenix-ci" autocomplete="off" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>

        <div class="field-row">
            <div class="field">
                <label asp-for="Clearance"></label>
                <select asp-for="Clearance" asp-items="Html.GetEnumSelectList<ClearanceLevel>()"></select>
            </div>
            <div class="field">
                <label asp-for="ProjectKey"></label>
                <input asp-for="ProjectKey" placeholder="PHOENIX" />
                <span asp-validation-for="ProjectKey" class="field-error"></span>
            </div>
        </div>

        <p class="hint muted">
            After creating it, issue an API key on the next screen. The key is shown once and
            presented as <code>Authorization: Bearer evk_…</code> (or <code>X-Api-Key</code>) to
            <code>/api/v1/secrets</code>. Clearance, project, network, and time rules all still apply.
        </p>

        <button type="submit" class="button primary">Create</button>
    </form>
</section>
