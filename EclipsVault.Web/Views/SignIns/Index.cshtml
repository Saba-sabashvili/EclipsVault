@model SignInHistoryViewModel
@{
    ViewData["Title"] = "Sign-in history";
    var history = Model.History;
    var summary = history.Summary;
    var now = DateTimeOffset.UtcNow;
}

<div class="page-header">
    <div>
        <h1>Sign-in history</h1>
        <p class="page-sub">
            Every recent attempt to sign in to your account — successful and rejected — newest first.
            Only your own sign-ins appear here. An attempt from a location you've never signed in from
            is flagged so you can spot anything you didn't do.
        </p>
    </div>
    @if (summary.NeedsAttention)
    {
        <span class="badge tone-critical" title="Failed attempts from a location you've never signed in from">
            @summary.SuspiciousCount to review
        </span>
    }
</div>

@if (history.IsEmpty)
{
    <partial name="_EmptyState" model="@(new EmptyState
           {
               Icon = "lock",
               Title = "No sign-in history yet",
               Message = "As you sign in — with your password, a passkey, or a recovery code — each attempt is recorded here so you can review it later and spot anything unfamiliar."
           })" />
}
else
{
    <section class="panel">
        <div class="stat-grid">
            <div class="stat-card">
                <span class="stat-value">@summary.SuccessCount</span>
                <span class="stat-label">Successful sign-ins</span>
                @if (summary.LastSuccessUtc is { } lastOk)
                {
                    <span class="stat-detail" title="@SignInDisplay.Absolute(lastOk)">last @SignInDisplay.Ago(lastOk, now)</span>
                }
            </div>
            <div class="stat-card@(summary.FailedCount > 0 ? " attention" : "")">
                <span class="stat-value">@summary.FailedCount</span>
                <span class="stat-label">Rejected attempts</span>
                @if (summary.LastFailedUtc is { } lastBad)
                {
                    <span class="stat-detail" title="@SignInDisplay.Absolute(lastBad)">last @SignInDisplay.Ago(lastBad, now)</span>
                }
            </div>
            <div class="stat-card@(summary.SuspiciousCount > 0 ? " alert" : "")">
                <span class="stat-value">@summary.SuspiciousCount</span>
                <span class="stat-label">From unfamiliar places</span>
                <span class="stat-detail">failed, never signed in from there</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@summary.DistinctLocations</span>
                <span class="stat-label">Distinct locations</span>
                <span class="stat-detail">by source address</span>
            </div>
        </div>
    </section>

    @if (summary.NeedsAttention)
    {
        <section class="panel callout-warn">
            <div class="panel-header"><h2>Don't recognise these attempts?</h2></div>
            <p class="muted">
                Someone tried to sign in from a place you've never signed in from. Your account wasn't
                opened from there — every attempt failed — but it's worth locking things down: change
                your password and sign out of every device.
            </p>
            <div class="button-row">
                <a class="button primary" asp-controller="Sessions" asp-action="Index">Review signed-in devices</a>
                <a class="button" asp-controller="Profile" asp-action="Index">Change password</a>
            </div>
        </section>
    }

    <section class="panel">
        <ul class="activity-feed">
            @foreach (var e in history.Events)
            {
                var badge = SignInDisplay.LocationBadge(e.LocationFlag);
                <li class="feed-item @SignInDisplay.FeedSeverity(e.Outcome)">
                    <span class="feed-icon">@SignInDisplay.Icon(e.Method)</span>
                    <div class="feed-body">
                        <div class="feed-title-row">
                            <span class="feed-title">@e.Title</span>
                            <span class="badge tone-@SignInDisplay.OutcomeTone(e.Outcome)">@SignInDisplay.OutcomeLabel(e.Outcome)</span>
                            <span class="badge tone-muted">@SignInDisplay.MethodLabel(e.Method)</span>
                            @if (badge is { } b)
                            {
                                <span class="badge tone-@b.Tone">@b.Text</span>
                            }
                        </div>
                        <div class="feed-meta">
                            <span class="mono">from @e.SourceIp</span>
                        </div>
                    </div>
                    <time class="feed-time" title="@SignInDisplay.Absolute(e.TimestampUtc)">
                        @SignInDisplay.Ago(e.TimestampUtc, now)
                    </time>
                </li>
            }
        </ul>
    </section>
}
