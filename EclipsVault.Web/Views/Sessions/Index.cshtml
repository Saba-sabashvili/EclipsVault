@model SessionsViewModel
@{
    ViewData["Title"] = "Signed-in devices";
    var now = DateTimeOffset.UtcNow;
}

<div class="page-header">
    <div>
        <h1>Signed-in devices</h1>
        <p class="page-sub">
            Every place your account is currently signed in. Don't recognise one? Sign it out — it
            loses access on its next request. To end <em>every</em> session at once (including this
            one), use <a asp-controller="Profile" asp-action="Index">sign out everywhere</a> on your profile.
        </p>
    </div>
    @if (Model.OtherCount > 0)
    {
        <form asp-action="RevokeOthers" method="post"
              data-confirm="Sign out all other devices? Each loses access on its next request.">
            <button type="submit" class="button">Sign out all other sessions</button>
        </form>
    }
</div>

@if (Model.Sessions.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyState
           {
               Icon = "lock",
               Title = "No recorded sessions yet",
               Message = "Your active sign-ins will appear here. If this looks empty, sign out and back in to register this device."
           })" />
}
else
{
    <section class="panel">
        <ul class="activity-feed">
            @foreach (var s in Model.Sessions)
            {
                <li class="feed-item@(s.IsCurrent ? " session-current" : "")">
                    <span class="feed-icon">@SessionDisplay.Icon(s.Device)</span>
                    <div class="feed-body">
                        <div class="feed-title-row">
                            <span class="feed-title">@s.Device</span>
                            @if (s.IsCurrent)
                            {
                                <span class="badge tone-ok">This device</span>
                            }
                        </div>
                        <div class="feed-meta">
                            <span class="mono">@s.IpAddress</span>
                            · signed in @SessionDisplay.Ago(s.CreatedAtUtc, now)
                            · last active <span title="@s.LastSeenAtUtc.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")">@SessionDisplay.Ago(s.LastSeenAtUtc, now)</span>
                        </div>
                    </div>
                    <div class="feed-action">
                        @if (s.IsCurrent)
                        {
                            <span class="muted current-pill">Current</span>
                        }
                        else
                        {
                            <form asp-action="Revoke" method="post"
                                  data-confirm="Sign out this device? It loses access on its next request.">
                                <input type="hidden" name="id" value="@s.SessionId" />
                                <button type="submit" class="button danger small">Sign out</button>
                            </form>
                        }
                    </div>
                </li>
            }
        </ul>
    </section>
}
