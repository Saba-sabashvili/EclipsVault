@model SecurityCheckupViewModel
@{
    ViewData["Title"] = "Security checkup";
    var checkup = Model.Checkup;
    var top = checkup.TopPriority;
    var arc = SecurityCheckupDisplay.ArcLength(checkup.Score);
    var gap = SecurityCheckupDisplay.RingCircumference - arc;
    var gradeClass = SecurityCheckupDisplay.GradeClass(checkup.Grade);
}

<div class="page-header">
    <div>
        <h1>Security checkup</h1>
        <p class="page-sub">
            A quick read on how well your account is protected. Everything here is about
            <em>your</em> account only — work through anything flagged to make it stronger.
        </p>
    </div>
</div>

<section class="panel checkup-hero">
    <div class="score-ring @gradeClass" role="img"
         aria-label="Security score @checkup.Score out of 100 — @SecurityCheckupDisplay.GradeLabel(checkup.Grade)">
        <svg viewBox="0 0 120 120" width="132" height="132">
            <circle class="ring-track" cx="60" cy="60" r="@SecurityCheckupDisplay.RingRadius"
                    fill="none" stroke-width="10" />
            <circle class="ring-value" cx="60" cy="60" r="@SecurityCheckupDisplay.RingRadius"
                    fill="none" stroke-width="10" stroke-linecap="round"
                    stroke-dasharray="@arc.ToString("F1") @gap.ToString("F1")"
                    transform="rotate(-90 60 60)" />
        </svg>
        <div class="score-center">
            <span class="score-number">@checkup.Score</span>
            <span class="score-outof">/ 100</span>
        </div>
    </div>

    <div class="checkup-summary">
        <span class="grade-label @gradeClass">@SecurityCheckupDisplay.GradeLabel(checkup.Grade)</span>
        @if (top is null)
        {
            <p class="checkup-lead">Everything checks out. Your account is well protected — nice work.</p>
        }
        else
        {
            <p class="checkup-lead">Next step: <strong>@top.Recommendation</strong></p>
        }
        <div class="checkup-counts">
            @if (checkup.ActionNeededCount > 0)
            {
                <span class="badge tone-danger">@checkup.ActionNeededCount action needed</span>
            }
            @if (checkup.RecommendedCount > 0)
            {
                <span class="badge tone-warn">@checkup.RecommendedCount recommended</span>
            }
            <span class="badge tone-ok">@checkup.PassCount secured</span>
        </div>
    </div>
</section>

<section class="panel">
    <ul class="activity-feed">
        @foreach (var check in checkup.Checks)
        {
            var route = SecurityCheckupDisplay.FixRoute(check.Fix);
            <li class="feed-item @SecurityCheckupDisplay.StatusClass(check.Status)">
                <span class="feed-icon">@SecurityCheckupDisplay.Icon(check.Kind)</span>
                <div class="feed-body">
                    <div class="feed-title-row">
                        <span class="feed-title">@check.Title</span>
                        <span class="badge tone-@SecurityCheckupDisplay.StatusTone(check.Status)">
                            @SecurityCheckupDisplay.StatusLabel(check.Status)
                        </span>
                    </div>
                    <div class="feed-meta">@check.Detail</div>
                    @if (check.Status != SecurityCheckStatus.Pass)
                    {
                        <div class="check-rec">@check.Recommendation</div>
                    }
                </div>
                <div class="feed-action">
                    @if (route is { } r && check.Status != SecurityCheckStatus.Pass)
                    {
                        <a class="button small" asp-controller="@r.Controller" asp-action="@r.Action">
                            @SecurityCheckupDisplay.CtaLabel(check.Kind)
                        </a>
                    }
                </div>
            </li>
        }
    </ul>
</section>
