<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test code is exempt from the production warnings-as-errors gate so xUnit analyzer
         suggestions don't fail CI; the projects under test keep the strict gate. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Runs the real EclipsVaultDbContext against in-memory SQLite, so the persistence guarantees
         the vault relies on are pinned without needing a database server in CI. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Direct reference only to lift the native library off the vulnerable 2.1.11 the provider pulls in. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EclipsVault.Core\EclipsVault.Core.csproj" />
    <ProjectReference Include="..\EclipsVault.Infrastructure\EclipsVault.Infrastructure.csproj" />
    <ProjectReference Include="..\EclipsVault.LicenseForge\EclipsVault.LicenseForge.csproj" />
  </ItemGroup>

</Project>
