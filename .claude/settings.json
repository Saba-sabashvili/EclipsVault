{
  "permissions": {
    "allow": [
      "Bash(dotnet restore --locked-mode)",
      "Bash(dotnet build EclipsVault.slnx -c Release)",
      "Bash(dotnet test EclipsVault.slnx -c Release --no-build --blame-hang-timeout 5m --blame-hang-dump-type mini)",
      "Bash(dotnet build-server shutdown)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
