    "deny": [
      "Bash(git difftool*)",
      "Bash(git * --output*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git branch --delete --force*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean*)"
    ]
  }
