{
  "permissions": {
    "allow": [
      "Bash(dotnet restore --locked-mode)",
      "Bash(dotnet build EclipsVault.slnx -c Release)",
      "Bash(dotnet test EclipsVault.slnx -c Release --no-build --blame-hang-timeout 5m --blame-hang-dump-type mini)",
      "Bash(dotnet build-server shutdown)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "deny": [
      "Bash(git difftool*)",
      "Bash(git * --output*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git branch --delete --force*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-git.py\"; [ -f \"$f\" ] || { echo \"BLOCKED: the git guard $f is missing; restore it from git first.\" >&2; exit 2; }; command -v python3 >/dev/null 2>&1 || { echo 'BLOCKED: the git guard needs python3 on PATH.' >&2; exit 2; }; exec python3 -I \"$f\"",
            "statusMessage": "Checking git command"
          }
        ]
      }
    ]
  }
}
